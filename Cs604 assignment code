#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <errno.h>
#include <limits.h>

#define CU_SIZE 100
#define REPORT_SIZE 1024
#define TASK_COUNT 3

typedef struct {
    long long total_time;
    int longest_task;
    int maximum_time;
} TaskResult;

int write_all(int fd, const void *buffer, size_t size) {
    const char *ptr = (const char *)buffer;
    size_t written = 0;

    while (written < size) {
        ssize_t n = write(fd, ptr + written, size - written);

        if (n < 0) {
            if (errno == EINTR)
                continue;
            return -1;
        }

        if (n == 0)
            break;
            
        written += n;
    }
    return (written == size) ? 0 : -1;
}

int main() {
    // IMPORTANT: Change this string to your actual Virtual University Student ID
    const char* student_id = "bc230412185"; 
    
    int pipe_parent_to_child[2];
    int pipe_child_to_parent[2];
    
    if (pipe(pipe_parent_to_child) == -1 || pipe(pipe_child_to_parent) == -1) {
        perror("Pipe creation failed");
        exit(EXIT_FAILURE);
    }
    
    pid_t pid = fork();
    
    if (pid < 0) {
        perror("Fork failed");
        exit(EXIT_FAILURE);
    }
    
    if (pid > 0) { 
        // ----------------- PARENT PROCESS -----------------
        close(pipe_parent_to_child[0]); 
        close(pipe_child_to_parent[1]); 
        
        int tasks[TASK_COUNT];
        
        // Take user input from the terminal
        printf("Parent Process: Please enter the task times.\n");
        for (int i = 0; i < TASK_COUNT; i++) {
            printf("Enter time for Task %d (in minutes): ", i + 1);
            scanf("%d", &tasks[i]);
        }
        
        printf("\nParent Process: Sending task times to child...\n");
        
        if (write_all(pipe_parent_to_child[1], tasks, sizeof(tasks)) == -1) {
            perror("Failed to write to pipe");
            exit(EXIT_FAILURE);
        }
        close(pipe_parent_to_child[1]); 
        
        TaskResult result;
        ssize_t bytes_read = read(pipe_child_to_parent[0], &result, sizeof(TaskResult));
        
        if (bytes_read == sizeof(TaskResult)) {
            printf("\nParent Process: Received results from child.\n");
            printf("Total Time: %lld minutes\n", result.total_time);
            printf("Longest Task: Task %d (%d minutes)\n", result.longest_task, result.maximum_time);
            
            char filename[CU_SIZE];
            snprintf(filename, sizeof(filename), "%s_report.txt", student_id);
            
            int fd = open(filename, O_WRONLY | O_CREAT | O_TRUNC, 0644);
            if (fd == -1) {
                perror("Failed to open file");
                exit(EXIT_FAILURE);
            }
            
            char report[REPORT_SIZE];
            int report_len = snprintf(report, sizeof(report), 
                "Student ID: %s\n"
                "Total Time: %lld minutes\n"
                "Longest Task: Task %d\n"
                "Maximum Time: %d minutes\n", 
                student_id, result.total_time, result.longest_task, result.maximum_time);
                
            if (write_all(fd, report, report_len) == 0) {
                printf("\nReport successfully saved to %s\n", filename);
            } else {
                perror("Failed to write report to file");
            }
            
            close(fd);
        } else {
            perror("Failed to read results from child");
        }
        
        close(pipe_child_to_parent[0]); 
        wait(NULL); 
        
    } else {
        // ----------------- CHILD PROCESS -----------------
        close(pipe_parent_to_child[1]); 
        close(pipe_child_to_parent[0]); 
        
        int received_tasks[TASK_COUNT];
        ssize_t bytes_read = read(pipe_parent_to_child[0], received_tasks, sizeof(received_tasks));
        
        if (bytes_read == sizeof(received_tasks)) {
            printf("\nChild Process: Processing tasks...\n");
            
            TaskResult result;
            result.total_time = 0;
            result.longest_task = -1;
            result.maximum_time = -1;
            
            for (int i = 0; i < TASK_COUNT; i++) {
                result.total_time += received_tasks[i];
                if (received_tasks[i] > result.maximum_time) {
                    result.maximum_time = received_tasks[i];
                    result.longest_task = i + 1;
                }
            }
            
            if (write_all(pipe_child_to_parent[1], &result, sizeof(TaskResult)) == -1) {
                perror("Failed to write to parent");
                exit(EXIT_FAILURE);
            }
        }
        
        close(pipe_parent_to_child[0]); 
        close(pipe_child_to_parent[1]); 
        exit(EXIT_SUCCESS);
    }
    
    return 0;
}
